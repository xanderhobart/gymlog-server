# Copy this file to .env to change a setting, then:  docker compose up -d --build
# Everything is optional.

# The admin token manages users (make, switch off, delete). If you leave this empty the server makes one on first start,
# prints it in its log and keeps it in ./data/admin_token.
GYMLOG_ADMIN_TOKEN=

# Biggest backup file one upload may be, in megabytes (a backup holds your photos too).
GYMLOG_MAX_UPLOAD_MB=500

# How many backups to keep for each person (older ones are removed automatically).
GYMLOG_KEEP_BACKUPS=10

# How much one person may store on the server, in megabytes.
GYMLOG_USER_QUOTA_MB=5000

# Wrong tokens allowed per minute from one address before it is slowed down.
GYMLOG_FAILED_LOGINS_PER_MINUTE=10
